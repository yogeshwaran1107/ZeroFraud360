# ==============================================================================
# ZeroFraud360 & IndianBankSimulation — Environment Configuration Template
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH LOCAL/SECRET VALUES
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# ZeroFraud360 Security & JWT (Port 8081)
# ------------------------------------------------------------------------------
# 256-bit HMAC-SHA256 signing secret for officer session JWTs
ZEROFRAUD_JWT_SECRET=REPLACE_ME_WITH_A_SECURE_256BIT_SECRET_KEY
ZEROFRAUD_JWT_EXPIRATION_SECONDS=3600

# ------------------------------------------------------------------------------
# IndianBankSimulation Internal Service Security (Port 8080)
# ------------------------------------------------------------------------------
# Shared service token between ZeroFraud360 and IndianBankSimulation
# Must match in both environments for internal financial-control API calls
BANK_SIMULATION_SERVICE_TOKEN=REPLACE_ME_WITH_A_SECURE_SERVICE_TOKEN

# ------------------------------------------------------------------------------
# Inter-Service Integration Endpoints
# ------------------------------------------------------------------------------
# IndianBankSimulation base URL reachable from ZeroFraud360
BANK_SIMULATION_BASE_URL=http://localhost:8080

# External Decision-Maker API URL (returns ALLOW or STOP)
# Decision API running at localhost:xxxx/fraud/verify
FRAUD_DECISION_API_URL=http://localhost:xxxx

# ------------------------------------------------------------------------------
# Database Configurations (MySQL running on localhost:3306)
# ------------------------------------------------------------------------------
DB_URL_ZEROFRAUD=jdbc:mysql://localhost:3306/zerofraud360_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL_BANKSIM=jdbc:mysql://localhost:3306/banksim_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
